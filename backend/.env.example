PORT=4000
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# ---------- BASE DE DONNEES (Turso) ----------
# Laissez les deux lignes ci-dessous VIDES en développement local : le serveur
# écrira alors dans un fichier local (./data/plateforme.db), aucun compte requis.
#
# En production, créez gratuitement une base sur https://turso.tech (pas de
# carte bancaire requise).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------- FICHIERS (PDF + couvertures) ----------
# Créez un compte gratuit sur https://cloudinary.com et renseignez les 3
# variables ci-dessous (visibles sur votre tableau de bord Cloudinary) pour que
# les PDF et couvertures soient stockés de façon permanente.
# Si ces variables sont vides, le serveur stocke les fichiers localement dans
# UPLOADS_DIR — pratique en développement, mais PAS persistant en production
# sur un hébergeur au disque éphémère (ex: Render plan gratuit).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADS_DIR=./data

# CORS : domaine(s) exact(s) de votre frontend en production (séparés par une
# virgule si plusieurs). Laissez vide en développement local.
CORS_ORIGIN=

# Compte propriétaire créé automatiquement par "npm run seed"
OWNER_EMAIL=owner@cahiers-benin.com
OWNER_PASSWORD=ChangeMe123!

# Moov Money Bénin — mode "sandbox" simule les paiements pour développer/tester
# sans contrat marchand. Passez à "live" une fois vos identifiants API obtenus
# auprès de Moov Africa, et complétez l'intégration réelle dans utils/payments.js.
MOOV_MODE=sandbox
