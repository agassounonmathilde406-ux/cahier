PORT=4000
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# Turso (base de données persistante) — à récupérer sur ton tableau de bord turso.tech
TURSO_DATABASE_URL=libsql://ton-nom-de-base.turso.io
TURSO_AUTH_TOKEN=colle-ici-ton-token-turso

# Compte propriétaire créé automatiquement par "npm run seed"
OWNER_EMAIL=owner@cahiers-benin.com
OWNER_PASSWORD=ChangeMe123!

# Moov Money Bénin — mode "sandbox" simule les paiements pour développer/tester
# sans contrat marchand. Passez à "live" une fois vos identifiants API obtenus
# auprès de Moov Africa, et complétez l'intégration réelle dans utils/payments.js.
MOOV_MODE=sandbox
